{
  "name": "selectorpass-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for SelectorPass Chrome extension",
  "scripts": {
    "test": "playwright test",
    "test:headed": "clear && playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  }
}